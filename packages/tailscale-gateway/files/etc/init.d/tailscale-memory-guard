#!/bin/sh /etc/rc.common
USE_PROCD=1
START=92
STOP=8

start_service() {
    local fingerprint
    config_load tailscale_memory
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    fingerprint=$(uci -q show tailscale_memory | sha256sum | cut -d' ' -f1)
    procd_open_instance guard
    procd_set_param command /usr/libexec/tailscale-memory-guard run "$fingerprint" 0.2.3-r1
    procd_set_param data "configuration=$fingerprint"
    procd_set_param respawn 60 5 0
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() { procd_add_reload_trigger tailscale_memory; }
