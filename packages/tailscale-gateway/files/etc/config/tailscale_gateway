config gateway 'main'
	option managed '0'
	option schema '1'

config uplink 'uplink'
	option enabled '0'
	option preferred ''
	option preferred6 ''
	option table '203'
	option interval '10'
	option fail_count '3'
	option recover_count '2'
	option restart_on_change '1'
	list probes '223.5.5.5'
	list probes '119.29.29.29'
	list probes6 '2400:3200::1'
	list probes6 '2606:4700:4700::1111'

config access 'access'
	option lan_enabled '0'
	option remote_enabled '0'
	option router_access '0'
	option subnet_access '0'
	option interface 'tailscale'
	option device 'tailscale0'
	option zone 'tailscale'
	list sources 'lan'
	list internet_zones 'wan'
	list targets '100.64.0.0/10'

config dns 'dns'
	option mode 'off'
	option instance ''
	option interval '60'
	option retry '5'
