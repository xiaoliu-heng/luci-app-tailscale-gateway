#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUN=/var/run/tailscale-gateway
mkdir -p "$RUN"
chmod 700 "$RUN"
exec 8>"$RUN/subnets.lock"
flock -n 8 || exit 0
. /usr/share/tailscale-gateway/worker.sh
sync_once() {
    (
        exec 9>"$RUN/apply.lock"
        flock -n 9 || exit 75
        ucode /usr/share/tailscale-gateway/main.uc subnet-sync >"$RUN/subnet-output.json" 2>"$RUN/subnet-error.log"
    )
}
tsg_worker 300 5 sync_once
