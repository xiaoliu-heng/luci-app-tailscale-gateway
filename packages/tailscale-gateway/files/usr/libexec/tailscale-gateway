#!/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUN=/var/run/tailscale-gateway
mkdir -p "$RUN"
chmod 700 "$RUN"
case "$1" in
    collect)
        exec 8>"$RUN/collector.lock"
        flock -n 8 || exit 0
        . /usr/share/tailscale-gateway/worker.sh
        collect_once() {
            ucode /usr/share/tailscale-gateway/main.uc snapshot >"$RUN/collector-output.json" 2>"$RUN/collector-error.log"
        }
        tsg_worker 60 5 collect_once
        ;;
    start-job)
        case "$2" in ''|*[!a-f0-9]*) exit 2;; esac
        [ ${#2} = 24 ] || exit 2
        (trap '' HUP; exec /usr/libexec/tailscale-gateway job "$2") </dev/null >"$RUN/job-output.log" 2>&1 &
        ;;
    job)
        exec 9>"$RUN/apply.lock"
        timeout 20 flock 9 || exit 1
        exec ucode /usr/share/tailscale-gateway/main.uc job "$2"
        ;;
    *) exec ucode /usr/share/tailscale-gateway/main.uc "$@";;
esac
